---
import { Analyzer } from '../components/Analyzer';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Analyze Microsoft 365, EOP, and Defender for Office 365 email headers. Every field explained, sourced, and graded for trustworthiness." />
    <title>HeaderLens — M365 Email Header Analyzer</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Content Security Policy
         frame-ancestors must be set as an HTTP header (not meta) to block clickjacking.
         Set X-Frame-Options: DENY and Content-Security-Policy: frame-ancestors 'none'
         at the hosting/CDN layer when deploying publicly. -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src https://fonts.gstatic.com; connect-src https://cloudflare-dns.com https://dns.google; img-src 'self' data:; base-uri 'self'; form-action 'none'; object-src 'none';" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Analyzer client:load />
  </body>
</html>
